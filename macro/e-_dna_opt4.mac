# Range of electrons, 12 eV to 1 MeV in liquid water with Geant4-DNA dna_opt2.
# The track length is compared with the ICRU 90 CSDA range.
# Validation macro, run unchanged by the CI (no /control/execute, loops or
# aliases). One /run/beamOn per energy: Run::EndOfRun appends one line per
# run to range.txt, read by validation/parser.py.
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 4
/random/setSeeds 12345 67890
#
/range/det/setMat G4_WATER
/range/det/setRadius 1 m
/range/det/setTrackingCut 10 eV
/range/phys/addPhysics dna_opt4
#
/run/initialize
/run/printProgress 0
#
/gun/particle e-
#
/gun/energy 12 eV
/run/beamOn 1000
#
/gun/energy 20 eV
/run/beamOn 1000
#
/gun/energy 50 eV
/run/beamOn 1000
#
/gun/energy 100 eV
/run/beamOn 1000
#
/gun/energy 200 eV
/run/beamOn 1000
#
/gun/energy 500 eV
/run/beamOn 1000
